# Copy to .env.local for local dev, and set the same in Vercel → Settings → Environment Variables.

# Supabase (Still's own project — not shared with Kraft Junction)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode keys to start)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Calendar — OAuth client for your own Google account, plus a
# refresh token generated once via the OAuth consent flow (see README's
# "Google Calendar setup" section).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Backup static meeting link used only if the Calendar API call fails after
# retries (calendar_sync_failed gets set true on the booking when this is used).
STILL_BACKUP_CALL_LINK=

# Resend
RESEND_API_KEY=
STILL_EMAIL_FROM="Still <still@joulekasima.com>"
STILL_PROVIDER_EMAIL=hello@joulekasima.com

# Cron protection — required, the route refuses every request if this is
# unset. Set any random string here (Vercel env var) AND as the GitHub repo
# secret STILL_CRON_SECRET (Settings → Secrets and variables → Actions) —
# same value in both places. The GitHub Actions workflow at
# .github/workflows/still-reminder-cron.yml calls the reminder route every
# 5 minutes using that secret as the Authorization: Bearer token (Vercel
# Hobby's own cron only runs once a day, too coarse for the 15-minute
# reminder window). Optionally also set the repo variable STILL_SITE_URL if
# the deployed URL isn't https://www.joulekasima.com.
CRON_SECRET=

# Used to build the cancellation link in confirmation emails.
SITE_URL=https://www.joulekasima.com
